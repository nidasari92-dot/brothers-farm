# Salin file ini menjadi .env lalu sesuaikan nilainya
PORT=3000
NODE_ENV=production

# Ganti dengan string acak yang panjang & rahasia (contoh: hasil `openssl rand -hex 32`)
JWT_SECRET=ganti_dengan_secret_yang_sangat_rahasia
JWT_EXPIRES_IN=8h

# Lokasi file database SQLite
DB_PATH=./data/brothersfarm.db

# Akun admin default yang dibuat otomatis saat pertama kali server jalan
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# (Opsional) API key untuk fitur agentic AI ekstraksi harga dari gambar
# Kosongkan jika fitur ini belum dipakai
AI_VISION_API_KEY=

# Email notification settings (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=CV Brothers Farm <your-email@gmail.com>
EMAIL_NOTIFY_ENABLED=false
EMAIL_ADMIN=admin@brothers-farm.test

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_API_BASE=https://api.sandbox.midtrans.com
